def execute_phonetic_muscle(client, sauti_faili, sahihisha=True):
    """Nukuu sauti ya Kiswahili kwa lugha iliyowekwa, kisha sahihisha tahajia."""
    try:
        data = sauti_faili.getvalue() if hasattr(sauti_faili, "getvalue") else sauti_faili.read()
        jina = getattr(sauti_faili, "name", "sauti.wav")

        elekezo = (
            "Hii ni imla ya Kiswahili sanifu. Habari, asante, maneno, mfumo, "
            "kuhakikisha, nitaangalia, wewe, hilo lilikuwa langu."
        )

        try:
            trans = client.audio.transcriptions.create(
                model="gpt-4o-transcribe",
                file=(jina, data),
                language="sw",
                prompt=elekezo,
            )
        except Exception:
            # Njia mbadala kama modeli ya kwanza haipatikani kwenye akaunti yako
            trans = client.audio.transcriptions.create(
                model="whisper-1",
                file=(jina, data),
                language="sw",
                prompt=elekezo,
                temperature=0,
            )

        maandishi = trans.text.strip()

        if sahihisha and maandishi:
            rekebisho = client.chat.completions.create(
                model="gpt-4o-mini",
                temperature=0,
                messages=[
                    {"role": "system", "content": (
                        "Wewe ni mhariri wa Kiswahili sanifu. Utapewa maandishi yaliyonukuliwa "
                        "kutoka sauti na yana makosa ya tahajia na maneno kukatwakatwa "
                        "(mfano: 'maeno' badala ya 'maneno', 'sante' badala ya 'asante', "
                        "'niku wapa' badala ya 'nakupa'). Rekebisha makosa hayo tu. "
                        "Usiongeze wala kupunguza maana. Rudisha maandishi yaliyosahihishwa tu, "
                        "bila maelezo."
                    )},
                    {"role": "user", "content": maandishi},
                ],
            )
            maandishi = rekebisho.choices[0].message.content.strip()

        return maandishi
    except Exception as e:
        return f"🛑 Fracture: {str(e)}"
